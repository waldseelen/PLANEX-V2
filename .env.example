# PLAN.EX Environment Variables Template
# Copy this file to .env.local for local development

# ============================================
# Supabase Configuration (Cloud Backend & RAG)
# ============================================
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
VITE_ALLOWED_AUTH_ORIGINS=http://localhost:3000,https://your-production-domain.com

# Service-role key for server-side (api/*) routes only. Never expose with a
# VITE_ prefix — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# OAuth Providers (Google + GitHub + Email)
# ============================================
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_GITHUB_AUTH=true
VITE_ENABLE_EMAIL_AUTH=true
# ============================================
# Stripe Configuration (Payment)
# ============================================
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# ============================================
# App Configuration
# ============================================
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000/api

# ============================================
# Feature Flags
# ============================================
# Enable cloud sync (local-to-Supabase bootstrap)
VITE_ENABLE_SYNC=true

# Enable AI features (requires OpenRouter API)
VITE_ENABLE_AI_FEATURES=false

# Enable social features (study rooms, leaderboard)
VITE_ENABLE_SOCIAL_FEATURES=false

# ============================================
# Environment
# ============================================
VITE_ENV=development

# ============================================
# OpenRouter (Socratic/Feynman/OCR/mindmap AI features)
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key

# ============================================
# Optional: Email Service (SendGrid/Resend)
# ============================================
# VITE_SENDGRID_API_KEY=your_sendgrid_api_key
